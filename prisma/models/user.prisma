enum UserGender {
  male
  female
  other
}

enum UserRole {
  admin
  moder
  user
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique @db.VarChar(100)
  name      String     @db.VarChar(100)
  gender    UserGender
  role      UserRole   @default(user)
  isActive  Boolean    @default(false)
  createdAt Int        @default(dbgenerated("extract(epoch from now())"))
  updatedAt Int        @default(dbgenerated("extract(epoch from now())"))

  articles Article[]
  comments Comment[]

  @@map("users")
}
