model Comment {
  id              Int       @id @default(autoincrement())
  authorId        Int
  author          User      @relation(fields: [authorId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  articleId       Int
  article         Article   @relation(fields: [articleId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  parentCommentId Int?
  parentComment   Comment?  @relation("ParentComment", fields: [parentCommentId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  rating          Int       @default(0)
  content         Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  childComments   Comment[] @relation("ParentComment")

  @@map("comments")
  @@index([authorId, articleId, parentCommentId])
}
